# Database
DATABASE_URL=postgresql://user:password@localhost:5432/artarb

# Optional: individual DB components (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=artarb
DB_USER=user
DB_PASSWORD=password

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# App settings
LOG_LEVEL=INFO
